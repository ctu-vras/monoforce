<?xml version="1.0" encoding="utf-8"?>

<launch>
  <arg name="rviz" default="true" doc="Launch RViz for data visualization or not"/>
  <arg name="gui" default="false" doc="Launch Gazebo GUI or not"/>
  <arg name="world" default="$(find monoforce_gazebo)/worlds/terrain.world"/>

  <!-- Gazebo world and spawn Husky robot -->
  <include file="$(find monoforce_gazebo)/launch/husky_sim.launch">
    <arg name="world" value="$(arg world)"/>
    <arg name="gui" value="$(arg gui)"/>
  </include>

  <!-- Elevation Mapping Cupy -->
  <node pkg="elevation_mapping_cupy" type="elevation_mapping_node" name="elevation_mapping" output="screen">
    <rosparam command="load" file="$(find monoforce_navigation)/config/elevation_mapping_cupy/core/core_param.yaml"/>
    <rosparam command="load" file="$(find monoforce_navigation)/config/elevation_mapping_cupy/setups/husky/simple.yaml"/>

    <remap from="/elevation_mapping/elevation_map_filter" to="/grid_map/terrain"/>
  </node>

  <!-- Launch RViz with the demo configuration. -->
  <node if="$(arg rviz)" name="rviz" pkg="rviz" type="rviz" args="-d $(dirname)/../config/rviz/monoforce.rviz"/>
</launch>